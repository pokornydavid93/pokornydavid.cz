{
  "name": "@axiom-dp/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prebuild": "pnpm --filter @axiom/next... build",
    "dev": "next dev",
    "build": "next build && node scripts/emit-axiom-integration-manifest.mjs",
    "start": "next start",
    "lint": "eslint",
    "design:audit": "node scripts/audit-design-primitives.mjs",
    "design:radii": "node scripts/validate-radius-contract.mjs",
    "design:surfaces": "node scripts/validate-surface-token-graph.mjs",
    "design:themes": "node scripts/validate-site-themes.mjs",
    "design:compositions": "node scripts/validate-composition-registry.mjs",
    "design:compositions:regression": "node scripts/verify-composition-regression.mjs",
    "design:components": "node scripts/validate-component-registry.mjs",
    "content:voice": "node scripts/validate-personal-voice.mjs",
    "content:articles:generate": "node scripts/generate-article-previews.mjs",
    "content:articles:audit": "node scripts/audit-article-editorial.mjs",
    "test:articles": "node --experimental-strip-types --test tests/unit/article-contract-bridge.test.mjs tests/unit/article-editorial.test.mjs tests/unit/article-runtime-provider.test.mjs tests/unit/article-source.test.mjs tests/unit/article-projections.test.mjs tests/unit/article-lead-context.test.mjs tests/unit/article-screening-review.test.mjs tests/unit/article-screening-intake.test.mjs tests/unit/article-screening-form-contract.test.mjs tests/unit/project-public-host.test.mjs",
    "test:services": "node --experimental-strip-types --test tests/unit/offering-runtime-provider.test.mjs",
    "test:phone-first": "node --experimental-strip-types --test tests/unit/phone-first-runtime.test.mjs tests/unit/overview-confirmation-email.test.mjs",
    "test:income-test": "node --experimental-strip-types --test tests/unit/income-test-calculation.test.mjs tests/unit/income-test-intake.test.mjs tests/unit/income-test-analytics.test.mjs",
    "test:booking": "node --experimental-strip-types --test tests/unit/public-booking-runtime.test.mjs tests/unit/public-booking-calendar.test.mjs",
    "test:release-safety": "node --experimental-strip-types --test tests/unit/site-indexing.test.mjs tests/unit/seo.test.mjs tests/unit/article-publication-dates.test.mjs",
    "homepage:validate": "node scripts/validate-homepage-content.mjs",
    "homepage:validate:release": "HOMEPAGE_REQUIRE_LAUNCH_READY=1 node scripts/validate-homepage-content.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "playwright:install": "playwright install chromium",
    "deploy:production": "bash ../../infra/deploy/apps/web/deploy.sh"
  },
  "dependencies": {
    "@axiom-dp/article-editorial": "workspace:*",
    "@axiom/next": "workspace:*",
    "@axiom/web-core": "workspace:*",
    "@axiom-dp/axiom-substrate": "workspace:*",
    "@axiom-dp/contracts": "workspace:*",
    "@axiom-dp/surface-engine": "workspace:*",
    "@next/third-parties": "^16.1.1",
    "@radix-ui/react-select": "^2.2.6",
    "@studio-freight/lenis": "^1.0.42",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cobe": "^0.6.5",
    "embla-carousel": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "gray-matter": "^4.0.3",
    "gsap": "^3.13.0",
    "lucide-react": "^0.554.0",
    "mathjs": "^15.1.0",
    "motion": "^12.23.26",
    "next": "16.3.4",
    "next-mdx-remote": "^5.0.0",
    "postcss": "^8.5.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.4.0",
    "three": "^0.182.0",
    "zod": "^4.4.3",
    "@axiom-dp/publication-runtime": "workspace:*"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.185.1",
    "eslint": "^9",
    "eslint-config-next": "16.0.3",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5"
  }
}
